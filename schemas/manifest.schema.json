{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://board-games.local/schemas/manifest.schema.json",
  "title": "Board Game Manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "spec_version",
    "edition",
    "players",
    "mechanics",
    "spec_files",
    "data_files",
    "conformance_tests"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "object",
      "required": ["en"],
      "properties": {
        "en": { "type": "string" },
        "ko": { "type": "string" }
      },
      "additionalProperties": { "type": "string" }
    },
    "spec_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "edition": {
      "type": "string"
    },
    "players": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 },
        "recommended": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        }
      },
      "additionalProperties": false
    },
    "mechanics": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "features": {
      "type": "object",
      "properties": {
        "hidden_information": { "type": "boolean" },
        "randomness": { "type": "boolean" },
        "domain_events": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "config_options": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "default", "description"],
        "properties": {
          "type": { "type": "string" },
          "default": {},
          "description": { "type": "string" }
        }
      }
    },
    "spec_files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "data_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "conformance_tests": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "reference_engine": {
      "type": "object",
      "properties": {
        "language": { "type": "string" },
        "module": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
