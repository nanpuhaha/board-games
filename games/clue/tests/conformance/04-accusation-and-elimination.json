        "rng_state": 1,
        "turn_number": 9,
        "turn_order": ["p1", "p2", "p3"],
        "current_player_index": 2,
        "phase": "TURN_START",
        "players": {
          "p1": { "id": "p1", "suspect": "scarlett", "hand": ["rope"], "eliminated": true, "pulled_into_room": false },
          "p2": { "id": "p2", "suspect": "mustard", "hand": ["dagger"], "eliminated": true, "pulled_into_room": false },
          "p3": { "id": "p3", "suspect": "white", "hand": ["wrench"], "eliminated": false, "pulled_into_room": false }
        },
        "tokens": {
          "scarlett": { "kind": "room", "room": "kitchen" },
          "mustard": { "kind": "hallway", "x": 0, "y": 17 },
          "white": { "kind": "hallway", "x": 9, "y": 0 },
          "green": { "kind": "hallway", "x": 14, "y": 0 },
          "peacock": { "kind": "hallway", "x": 23, "y": 6 },
