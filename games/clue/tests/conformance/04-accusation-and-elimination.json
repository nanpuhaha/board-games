      "when": { "type": "MAKE_ACCUSATION", "player": "p3", "suspect": "green", "weapon": "rope", "room": "hall" },
      "then": {
        "state_subset": {
          "phase": "GAME_OVER"
        },
        "outcome": {
          "winner": null,
          "reason": "ALL_ELIMINATED"
        }
      }
    }
  ]
