        },
        "outcome": null,
        "events_contain": [
          { "type": "PLAYER_ELIMINATED", "visibility": "public", "payload": { "player": "p1" } },
          { "type": "TURN_STARTED", "visibility": "public", "payload": { "player": "p2" } }
        ]
      }
    },
    {
