{
  "game": "clue",
  "suite": "bonus-cards",
  "description": "Question mark (?) space triggers, deck recycling, and bonus card effects",
  "cases": [
    {
      "id": "land-on-question-mark-draws-extra-turn-and-recycles-deck",
      "description": "Landing on (1,7) '?' draws extra_turn, recycles card to bottom, and sets extra_turn_pending",
      "given": {
        "config": { "enable_bonus_cards": true, "accusation_requires_room": false },
        "rng_state": 1,
        "turn_number": 1,
        "turn_order": ["p1", "p2", "p3"],
        "current_player_index": 0,
        "phase": "MOVE",
        "players": {
          "p1": { "id": "p1", "suspect": "scarlett", "hand": ["rope"], "eliminated": false, "pulled_into_room": false },
          "p2": { "id": "p2", "suspect": "mustard", "hand": ["dagger"], "eliminated": false, "pulled_into_room": false },
          "p3": { "id": "p3", "suspect": "white", "hand": ["wrench"], "eliminated": false, "pulled_into_room": false }
        },
        "tokens": {
          "scarlett": { "kind": "hallway", "x": 2, "y": 7 },
          "mustard": { "kind": "hallway", "x": 0, "y": 17 },
          "white": { "kind": "hallway", "x": 9, "y": 0 },
          "green": { "kind": "hallway", "x": 14, "y": 0 },
          "peacock": { "kind": "hallway", "x": 23, "y": 6 },
          "plum": { "kind": "hallway", "x": 22, "y": 19 }
        },
        "weapons": { "candlestick": "kitchen", "dagger": "ballroom", "lead_pipe": "conservatory", "revolver": "dining_room", "rope": "billiard_room", "wrench": "library" },
        "envelope": { "suspect": "plum", "weapon": "candlestick", "room": "study" },
        "bonus_deck": ["bonus_extra_turn_1", "bonus_teleport_1"],
        "dice": [1, 2],
        "movement_remaining": 3,
        "extra_turn_pending": false,
        "pending_suggestion": null,
        "pending_bonus": null,
        "public_revealed_cards": [],
        "outcome": null
      },
      "when": { "type": "MOVE_TO_HALLWAY", "player": "p1", "x": 1, "y": 7 },
      "then": {
        "state_subset": {
          "phase": "POST_MOVE",
          "extra_turn_pending": true,
          "bonus_deck": ["bonus_teleport_1", "bonus_extra_turn_1"]
        },
        "events_contain": [
          { "type": "BONUS_CARD_DRAWN", "visibility": "public", "payload": { "player": "p1", "card_id": "bonus_extra_turn_1", "effect": "extra_turn" } },
          { "type": "BONUS_EFFECT_RESOLVED", "visibility": "public", "payload": { "player": "p1", "card_id": "bonus_extra_turn_1", "effect": "extra_turn" } }
        ]
      }
    },
