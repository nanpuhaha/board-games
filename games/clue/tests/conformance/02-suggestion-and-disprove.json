        "bonus_deck": [],
        "dice": [2, 2],
        "movement_remaining": 0,
        "extra_turn_pending": false,
        "pending_suggestion": {
          "suggester": "p1",
          "suspect": "mustard",
          "weapon": "candlestick",
          "room": "kitchen",
          "responder_queue": ["p2", "p3"],
