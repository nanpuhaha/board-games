{
  "game": "clue",
  "suite": "suggestion-and-disprove",
  "description": "Suggestion summoning, clockwise disproving, private card reveal, and mandatory disprove enforcement",
  "cases": [
    {
      "id": "make-suggestion-pulls-suspect-and-weapon",
      "description": "MAKE_SUGGESTION moves suspect and weapon into room and marks pulled_into_room",
      "given": {
        "config": { "enable_bonus_cards": true, "accusation_requires_room": false },
        "rng_state": 1,
        "turn_number": 1,
        "turn_order": ["p1", "p2", "p3"],
        "current_player_index": 0,
        "phase": "POST_MOVE",
        "players": {
          "p1": { "id": "p1", "suspect": "scarlett", "hand": ["rope"], "eliminated": false, "pulled_into_room": false },
          "p2": { "id": "p2", "suspect": "mustard", "hand": ["dagger"], "eliminated": false, "pulled_into_room": false },
          "p3": { "id": "p3", "suspect": "white", "hand": ["kitchen"], "eliminated": false, "pulled_into_room": false }
        },
        "tokens": {
          "scarlett": { "kind": "room", "room": "kitchen" },
          "mustard": { "kind": "hallway", "x": 0, "y": 17 },
          "white": { "kind": "hallway", "x": 9, "y": 0 },
          "green": { "kind": "hallway", "x": 14, "y": 0 },
          "peacock": { "kind": "hallway", "x": 23, "y": 6 },
          "plum": { "kind": "hallway", "x": 22, "y": 19 }
        },
        "weapons": { "candlestick": "hall", "dagger": "ballroom", "lead_pipe": "conservatory", "revolver": "dining_room", "rope": "billiard_room", "wrench": "library" },
        "envelope": { "suspect": "plum", "weapon": "candlestick", "room": "study" },
        "bonus_deck": [],
        "dice": [2, 2],
        "movement_remaining": 0,
        "extra_turn_pending": false,
        "pending_suggestion": null,
        "pending_bonus": null,
        "public_revealed_cards": [],
        "outcome": null
      },
      "when": { "type": "MAKE_SUGGESTION", "player": "p1", "suspect": "mustard", "weapon": "candlestick" },
      "then": {
        "state_subset": {
          "phase": "DISPROVE",
          "tokens": {
            "mustard": { "kind": "room", "room": "kitchen" }
          },
          "weapons": {
            "candlestick": "kitchen"
          },
          "players": {
            "p2": { "pulled_into_room": true }
          },
          "pending_suggestion": {
            "suggester": "p1",
            "suspect": "mustard",
            "weapon": "candlestick",
            "room": "kitchen",
            "responder_queue": ["p2", "p3"],
            "current_responder_index": 0
          }
        },
        "events_contain": [
          { "type": "SUGGESTION_MADE", "visibility": "public", "payload": { "suggester": "p1", "suspect": "mustard", "weapon": "candlestick", "room": "kitchen" } }
        ]
      }
    },
